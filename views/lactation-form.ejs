<%- include('partials/header') %>
<section class="page-heading">
  <div>
    <a class="back-link" href="/pecuaria/lactacoes">&larr; Registro de Lactações</a>
    <p class="eyebrow">REBANHO · PRODUÇÃO LEITEIRA</p>
    <h1>Nova Lactação</h1>
  </div>
</section>
<% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
<section class="user-create-section">
  <h2>Dados da lactação</h2>
  <% if (animals.length) { %>
    <form class="property-form livestock-form" method="post" action="/pecuaria/lactacoes">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Fêmea
        <select name="animalId" required>
          <option value="">Selecione</option>
          <% animals.forEach((animal) => { %>
            <option value="<%= animal.idAnimal %>" <%= Number(formValues.animalId) === animal.idAnimal ? 'selected' : '' %>><%= animal.Brinco || `Animal ${animal.idAnimal}` %> · <%= animal.PropriedadeNome %> · <%= animal.ProdutorNome %></option>
          <% }) %>
        </select>
      </label>
      <label>Início da lactação<input type="date" name="startDate" required max="<%= new Date().toISOString().slice(0, 10) %>" value="<%= formValues.startDate %>"></label>
      <div class="property-form-actions livestock-form-actions">
        <button class="primary-button" type="submit">Registrar lactação</button>
        <a class="secondary-button" href="/pecuaria/lactacoes">Cancelar</a>
      </div>
    </form>
  <% } else { %>
    <p class="empty-state">Não há fêmeas disponíveis sem prenhez ou lactação ativa para registrar.</p>
    <a class="secondary-button" href="/pecuaria/lactacoes">Voltar para Lactações</a>
  <% } %>
</section>
<%- include('partials/footer') %>