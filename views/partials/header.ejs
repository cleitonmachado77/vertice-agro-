<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f8f6f2">
  <title><%= pageTitle %> | Vértice Agro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/modulos" aria-label="Vértice Agro, início">
      <img class="brand-logo" src="/vertice-agro-logo.svg" alt="">
      <span>Vértice Agro</span>
    </a>
    <% if (user) { %>
      <div class="topbar-user">
        <span class="user-name"><%= user.Nome %></span>
        <span class="role-label"><%= user.Perfil %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="text-button" type="submit">Sair</button>
        </form>
      </div>
    <% } %>
  </header>
  <main class="page-shell <%= user && (currentPath.startsWith('/admin') || currentPath.startsWith('/agricultura') || currentPath === '/modulos/agricultura' || currentPath.startsWith('/pecuaria') || currentPath === '/modulos/pecuaria') ? 'admin-page-shell' : '' %>">
    <% if (user && currentPath.startsWith('/admin')) { %>
      <div class="admin-layout">
        <%- include('admin-navigation') %>
        <section class="admin-content">
    <% } else if (user && (currentPath.startsWith('/agricultura') || currentPath === '/modulos/agricultura')) { %>
      <div class="admin-layout agriculture-layout">
        <%- include('agriculture-navigation') %>
        <section class="admin-content">
    <% } else if (user && (currentPath.startsWith('/pecuaria') || currentPath === '/modulos/pecuaria')) { %>
      <div class="admin-layout agriculture-layout livestock-layout">
        <%- include('livestock-navigation') %>
        <section class="admin-content">
    <% } %>